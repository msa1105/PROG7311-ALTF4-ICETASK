@model FinanceTrack.Models.Transaction

@{
    ViewData["Title"] = "Add Transaction";
}

<div class="page-header">
    <div class="page-title">
        <h1>Add Transaction</h1>
        <p>Record a new transaction to the ledger</p>
    </div>
</div>

<div class="chart-card" style="max-width: 600px;">
    <form method="post" action="/Transactions/Add">
        <div style="display: flex; flex-direction: column; gap: 16px;">
            <div>
                <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:14px;">Entity Name</label>
                <input type="text" name="EntityName" class="search-input" style="width:100%;" required />
            </div>
            <div>
                <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:14px;">Category</label>
                <input type="text" name="Category" class="search-input" style="width:100%;" required />
            </div>
            <div>
                <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:14px;">Amount (R)</label>
                <input type="number" name="Amount" class="search-input" style="width:100%;" step="0.01" min="0" required />
            </div>
            <div>
                <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:14px;">Type</label>
                <select name="Type" class="filter-select" style="width:100%;" required>
                    <option value="Income">Income</option>
                    <option value="Expense">Expense</option>
                    <option value="Asset">Asset</option>
                    <option value="Liability">Liability</option>
                    <option value="Receivable">Receivable</option>
                </select>
            </div>
            <div>
                <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:14px;">Status</label>
                <select name="Status" class="filter-select" style="width:100%;" required>
                    <option value="Pending">Pending</option>
                    <option value="Paid">Paid</option>
                </select>
            </div>
            <div>
                <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:14px;">Due Date</label>
                <input type="date" name="DueDate" class="filter-select" style="width:100%;" />
            </div>
            <div style="display:flex; gap:12px; margin-top:8px;">
                <button type="submit" class="btn">Save Transaction</button>
                <a href="/Transactions/Ledger" class="btn" style="background:var(--bg-card); border:1px solid var(--border); color:var(--text-secondary);">Cancel</a>
            </div>
        </div>
    </form>
</div>
